<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {{ 'bangers-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2' }}
    {{ 'poppins-700.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2' }}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {% render 'meta-tags' %}

    <style>
      :root {
        --color-accent: {{ settings.color_accent }};
        --color-accent-deep: {{ settings.color_accent_deep }};
        --color-cta: {{ settings.color_cta }};
        --color-cta-rgb: {{ settings.color_cta.red }}, {{ settings.color_cta.green }}, {{ settings.color_cta.blue }};
        --color-text: {{ settings.color_text }};
        --color-text-rgb: {{ settings.color_text.red }}, {{ settings.color_text.green }}, {{ settings.color_text.blue }};
        --color-bg: {{ settings.color_background }};
        --color-bg-alt: {{ settings.color_background_alt }};
        --color-cream: {{ settings.color_cream }};
        --color-dark: {{ settings.color_dark }};
        --color-star: {{ settings.color_star }};
        --font-body-url-400: url("{{ 'poppins-400.woff2' | asset_url }}");
        --page-width: {{ settings.page_width }}px;
      }
      @font-face { font-family: "Poppins"; font-weight: 400; font-style: normal; font-display: swap; src: url("{{ 'poppins-400.woff2' | asset_url }}") format("woff2"); }
      @font-face { font-family: "Poppins"; font-weight: 700; font-style: normal; font-display: swap; src: url("{{ 'poppins-700.woff2' | asset_url }}") format("woff2"); }
      @font-face { font-family: "Poppins"; font-weight: 400; font-style: italic; font-display: swap; src: url("{{ 'poppins-400i.woff2' | asset_url }}") format("woff2"); }
      @font-face { font-family: "Poppins"; font-weight: 700; font-style: italic; font-display: swap; src: url("{{ 'poppins-700i.woff2' | asset_url }}") format("woff2"); }
      @font-face { font-family: "Bangers"; font-weight: 400; font-style: normal; font-display: swap; src: url("{{ 'bangers-latin.woff2' | asset_url }}") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: "Bangers"; font-weight: 400; font-style: normal; font-display: swap; src: url("{{ 'bangers-latin-ext.woff2' | asset_url }}") format("woff2");
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}

    <script>
      window.theme = {
        moneyFormat: {{ shop.money_format | json }},
        routes: {
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          cartGet: '{{ routes.cart_url }}.js',
          predictiveSearch: {{ routes.predictive_search_url | json }},
          search: {{ routes.search_url | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          cartTitle: {{ 'cart.title' | t | json }},
          items: {{ 'cart.items' | t | json }},
          saving: {{ 'cart.saving' | t | json }}
        }
      };
    </script>
  </body>
</html>
