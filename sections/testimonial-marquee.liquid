{%- comment -%}
  Infinite horizontal marquee of customer photos. Each card shows the cat photo
  with the owner's avatar in a corner, plus a short quote and name.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="marquee-reviews" id="customer-photos" style="--marquee-duration: {{ section.settings.speed }}s;">
  {%- if section.settings.heading != blank -%}
    <div class="page-width marquee-reviews__head">
      <h2 class="marquee-reviews__heading display">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank %}<p class="marquee-reviews__sub">{{ section.settings.subheading | escape }}</p>{% endif -%}
    </div>
  {%- endif -%}
  {%- for row in (1..2) -%}
    <div class="marquee{% if row == 2 %} marquee--reverse{% endif %}" data-marquee>
      <div class="marquee__track">
        {%- for pass in (1..2) -%}
          <ul class="marquee__list list-unstyled" role="list" {% if pass == 2 %}aria-hidden="true"{% endif %}>
            {%- for block in section.blocks -%}
              {%- comment -%} Liquid has no operator precedence, so compute the row once {%- endcomment -%}
              {%- assign block_row = forloop.index | modulo: 2 -%}
              {%- if block_row == 0 -%}{%- assign block_row = 2 -%}{%- endif -%}
              {%- if block_row == row -%}
                <li class="review-card review-card--{{ block.settings.avatar_position }}" {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}>
                  <div class="review-card__media">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 720, height: 720, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
                    {%- elsif block.settings.image_fallback != blank -%}
                      <img src="{{ block.settings.image_fallback | asset_url }}" alt="" loading="lazy" width="720" height="720">
                    {%- endif -%}
                    <span class="review-card__avatar">
                      {%- if block.settings.avatar != blank -%}
                        {{ block.settings.avatar | image_url: width: 200, height: 200, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
                      {%- elsif block.settings.avatar_fallback != blank -%}
                        <img src="{{ block.settings.avatar_fallback | asset_url }}" alt="" loading="lazy" width="200" height="200">
                      {%- endif -%}
                    </span>
                  </div>
                  <div class="review-card__body">
                    <div class="review-card__stars">{% render 'stars', rating: block.settings.rating %}</div>
                    <p class="review-card__quote">&ldquo;{{ block.settings.quote | escape }}&rdquo;</p>
                    <p class="review-card__name">{{ block.settings.name | escape }}{% if block.settings.verified %} <span class="review-card__verified">{% render 'icon', name: 'check' %} Verified buyer</span>{% endif %}</p>
                  </div>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endfor -%}
      </div>
    </div>
  {%- endfor -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Customer photo marquee",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Happy cats everywhere" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real photos from real Cat Punch owners" },
    { "type": "range", "id": "speed", "min": 20, "max": 120, "step": 5, "unit": "s", "label": "Scroll duration (one full loop)", "default": 60 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Cat photo" },
        { "type": "text", "id": "image_fallback", "label": "Cat photo fallback asset", "default": "review-cat-1.webp" },
        { "type": "image_picker", "id": "avatar", "label": "Customer photo (circle)" },
        { "type": "text", "id": "avatar_fallback", "label": "Customer photo fallback asset", "default": "review-avatar-1.webp" },
        { "type": "select", "id": "avatar_position", "label": "Avatar corner", "default": "bottom-left", "options": [
          { "value": "top-left", "label": "Top left" }, { "value": "top-right", "label": "Top right" },
          { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-right", "label": "Bottom right" } ] },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Stars", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "My cat is obsessed with this thing." },
        { "type": "text", "id": "name", "label": "Name", "default": "Emma R." },
        { "type": "checkbox", "id": "verified", "label": "Show verified buyer badge", "default": true }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [ { "name": "Customer photo marquee" } ]
}
{% endschema %}
