<section class="section feature-cards reveal" id="about">
  <div class="page-width">
    <ul class="feature-cards__grid list-unstyled reveal__item" role="list">
      {%- for block in section.blocks -%}
        <li class="feature-card" style="background: {{ block.settings.color }};" {{ block.shopify_attributes }}>
          <div class="feature-card__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 900', sizes: '(min-width: 750px) 33vw, 100vw' }}
            {%- elsif block.settings.fallback != blank -%}
              <img src="{{ block.settings.fallback | asset_url }}" alt="" loading="lazy" width="900" height="900">
            {%- endif -%}
          </div>
          <div class="feature-card__body">
            <h3 class="feature-card__heading display">{{ block.settings.heading | escape }}</h3>
            {%- if block.settings.text != blank %}<p class="feature-card__text">{{ block.settings.text | escape }}</p>{% endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Feature cards",
  "settings": [],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Fallback asset filename", "info": "Used when no image is picked, e.g. pdp-feature-base.webp", "default": "pdp-feature-base.webp" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Strong suction cup base" },
        { "type": "text", "id": "text", "label": "Text", "default": "Stays securely in place during even the wildest play." },
        { "type": "color", "id": "color", "label": "Card colour", "default": "#FFD21E" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [ { "name": "Feature cards", "blocks": [ { "type": "card" }, { "type": "card" }, { "type": "card" } ] } ]
}
{% endschema %}
