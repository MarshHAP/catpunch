<section class="section testimonials reveal" id="reviews">
  <div class="testimonials__inner page-width">
    <div class="title-wrapper reveal__item">
      <h2 class="testimonials__heading display">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.rating > 0 -%}
        <div class="testimonials__rating">{% render 'stars', rating: section.settings.rating %}</div>
      {%- endif -%}
      {%- if section.settings.subheading != blank %}<p class="testimonials__subheading">{{ section.settings.subheading | escape }}</p>{% endif -%}
    </div>
    <ul class="testimonials__grid list-unstyled reveal__item" role="list" style="--cols: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        <li class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-card__image-wrapper">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 800', sizes: '(min-width: 990px) 25vw, 80vw' }}
            {%- elsif block.settings.fallback != blank -%}
              <img src="{{ block.settings.fallback | asset_url }}" alt="" loading="lazy" width="800" height="600">
            {%- endif -%}
          </div>
          <div class="testimonial-card__info">
            <div class="testimonial-card__stars">{% render 'stars', rating: block.settings.rating %}</div>
            <p class="testimonial-card__body">&ldquo;{{ block.settings.text | escape }}&rdquo;</p>
            <p class="testimonial-card__author">{{ block.settings.author | escape }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real cats. Real results." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Join thousands of happy cat owners." },
    { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 0.5, "label": "Overall rating", "default": 5 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "fallback", "label": "Fallback asset filename", "default": "pdp-review-1.webp" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Stars", "default": 5 },
        { "type": "textarea", "id": "text", "label": "Quote", "default": "My cat is obsessed! Plays with it every day." },
        { "type": "text", "id": "author", "label": "Author", "default": "Emma R." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "Reviews", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "review" } ] } ]
}
{% endschema %}
