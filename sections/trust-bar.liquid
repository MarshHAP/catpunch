<section class="trust-bar">
  <div class="page-width">
    <ul class="icon-row icon-row--trust list-unstyled" role="list">
      {%- for block in section.blocks -%}
        <li class="icon-row__item" {{ block.shopify_attributes }}>
          <span class="icon-row__icon">{% render 'icon', name: block.settings.icon %}</span>
          <span class="icon-row__text">
            <span class="icon-row__title">{{ block.settings.title | escape }}</span>
            {%- if block.settings.text != blank %}<span class="icon-row__sub">{{ block.settings.text | escape }}</span>{% endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Trust bar",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [ { "value": "paw", "label": "Paw" }, { "value": "bolt", "label": "Bolt" }, { "value": "heart", "label": "Heart" }, { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }, { "value": "lock", "label": "Lock" }, { "value": "brain", "label": "Brain" }, { "value": "home", "label": "Home" }, { "value": "cat", "label": "Cat" }, { "value": "check", "label": "Check" } ] },
        { "type": "text", "id": "title", "label": "Title", "default": "£4.99 UK shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "Free on orders over £50" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "Trust bar", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
