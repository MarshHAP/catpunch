<section class="section page-width customer">
  <h1 class="h1 section-title">{{ 'customer.order.title' | t: name: order.name }}</h1>
  <p>{{ 'customer.order.date_html' | t: date: order.created_at | date: '%d %B %Y' }}</p>
  <table class="order-table">
    <thead><tr><th>{{ 'customer.order.product' | t }}</th><th>{{ 'customer.order.quantity' | t }}</th><th>{{ 'customer.order.total' | t }}</th></tr></thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr><td>{{ line_item.title | escape }}</td><td>{{ line_item.quantity }}</td><td>{{ line_item.final_line_price | money }}</td></tr>
      {%- endfor -%}
    </tbody>
    <tfoot>
      <tr><td colspan="2">{{ 'customer.order.subtotal' | t }}</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
      {%- for shipping_method in order.shipping_methods -%}<tr><td colspan="2">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td><td>{{ shipping_method.price | money }}</td></tr>{%- endfor -%}
      {%- for tax_line in order.tax_lines -%}<tr><td colspan="2">{{ 'customer.order.tax' | t }} ({{ tax_line.title }})</td><td>{{ tax_line.price | money }}</td></tr>{%- endfor -%}
      <tr><td colspan="2"><strong>{{ 'customer.order.total' | t }}</strong></td><td><strong>{{ order.total_price | money }}</strong></td></tr>
    </tfoot>
  </table>
  <p><a class="link" href="{{ routes.account_url }}">&larr; {{ 'customer.account.title' | t }}</a></p>
</section>
{% schema %}
{ "name": "Order", "settings": [] }
{% endschema %}
