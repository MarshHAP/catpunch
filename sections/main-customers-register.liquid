<section class="section page-width page--narrow customer">
  <h1 class="h1 section-title">{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <div class="field-row">
      <label class="field"><span>{{ 'customer.register.first_name' | t }}</span><input type="text" name="customer[first_name]" autocomplete="given-name"></label>
      <label class="field"><span>{{ 'customer.register.last_name' | t }}</span><input type="text" name="customer[last_name]" autocomplete="family-name"></label>
    </div>
    <label class="field"><span>{{ 'customer.register.email' | t }}</span><input type="email" name="customer[email]" autocomplete="email" required></label>
    <label class="field"><span>{{ 'customer.register.password' | t }}</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
    <button type="submit" class="button button--cta">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
</section>
{% schema %}
{ "name": "Register", "settings": [] }
{% endschema %}
