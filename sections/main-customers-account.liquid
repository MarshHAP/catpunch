<section class="section page-width customer">
  <h1 class="h1 section-title">{{ 'customer.account.title' | t }}</h1>
  <p><a class="link" href="{{ routes.account_logout_url }}">{{ 'customer.account.log_out' | t }}</a></p>
  <div class="customer__grid">
    <div>
      <h2 class="h3">{{ 'customer.account.orders' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="order-table"><thead><tr><th>Order</th><th>Date</th><th>Status</th><th>Total</th></tr></thead><tbody>
            {%- for order in customer.orders -%}
              <tr><td><a class="link" href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: '%d %b %Y' }}</td><td>{{ order.financial_status_label }} / {{ order.fulfillment_status_label }}</td><td>{{ order.total_price | money }}</td></tr>
            {%- endfor -%}
          </tbody></table>
          {%- if paginate.pages > 1 -%}{{ paginate | default_pagination }}{%- endif -%}
        {%- else -%}
          <p>{{ 'customer.account.no_orders' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
    <div>
      <h2 class="h3">{{ 'customer.account.details' | t }}</h2>
      {{ customer.default_address | format_address }}
      <a class="link" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses.title' | t }}</a>
    </div>
  </div>
</section>
{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
