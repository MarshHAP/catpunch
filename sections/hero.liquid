<section class="hero sunburst" id="hero">
  <div class="page-width hero__inner">
    <div class="hero__copy">
      {% render 'wordmark', size: 64, class: 'hero__wordmark' %}
      {%- if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank -%}
        <p class="hero__heading display">
          {%- if section.settings.heading_line_1 != blank %}<span>{{ section.settings.heading_line_1 | escape }}</span>{% endif -%}
          {%- if section.settings.heading_line_2 != blank %}<span>{{ section.settings.heading_line_2 | escape }}</span>{% endif -%}
        </p>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="hero__badges list-unstyled" role="list">
          {%- for block in section.blocks -%}
            <li class="hero__badge" {{ block.shopify_attributes }}>
              <span class="icon-disc icon-disc--dark">{% render 'icon', name: block.settings.icon %}</span>
              <span class="hero__badge-label display">{{ block.settings.label | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#featured-product' }}" class="button button--cta button--lg hero__cta">
          {{ section.settings.button_label | escape }}
          {% render 'icon', name: 'arrow-right', class: 'button__arrow' %}
        </a>
      {%- endif -%}
    </div>
    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200', sizes: '(min-width: 750px) 50vw, 100vw', class: 'hero__image' }}
      {%- else -%}
        <img class="hero__image" src="{{ 'pdp-hero-box.webp' | asset_url }}" alt="{{ shop.name }} retail box" width="1100" height="1100" fetchpriority="high">
      {%- endif -%}
      {%- if section.settings.sticker_1 != blank -%}
        <div class="hero__sticker display" aria-hidden="true">
          <span>{{ section.settings.sticker_1 | escape }}</span>
          {%- if section.settings.sticker_2 != blank %}<span>{{ section.settings.sticker_2 | escape }}</span>{% endif -%}
          {%- if section.settings.sticker_3 != blank %}<span>{{ section.settings.sticker_3 | escape }}</span>{% endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "Keep your cat active" },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2", "default": "Happy & healthy" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Falls back to the retail box photo when empty." },
    { "type": "text", "id": "sticker_1", "label": "Sticker line 1", "default": "Play" },
    { "type": "text", "id": "sticker_2", "label": "Sticker line 2", "default": "Fight" },
    { "type": "text", "id": "sticker_3", "label": "Sticker line 3", "default": "Stay active!" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "paw", "options": [
          { "value": "paw", "label": "Paw" }, { "value": "bolt", "label": "Bolt" }, { "value": "heart", "label": "Heart" },
          { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }, { "value": "lock", "label": "Lock" },
          { "value": "brain", "label": "Brain" }, { "value": "home", "label": "Home" }, { "value": "cat", "label": "Cat" }, { "value": "check", "label": "Check" } ] },
        { "type": "text", "id": "label", "label": "Label", "default": "Builds healthy habits" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "Hero", "blocks": [ { "type": "badge" }, { "type": "badge" }, { "type": "badge" } ] } ]
}
{% endschema %}
