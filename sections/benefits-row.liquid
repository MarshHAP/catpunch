<section class="benefits-row">
  <div class="page-width">
    <ul class="icon-row icon-row--benefit list-unstyled" role="list">
      {%- for block in section.blocks -%}
        <li class="icon-row__item" {{ block.shopify_attributes }}>
          <span class="icon-disc">{% render 'icon', name: block.settings.icon %}</span>
          <span class="icon-row__text">
            <span class="icon-row__title">{{ block.settings.title | escape }}</span>
            {%- if block.settings.text != blank %}<span class="icon-row__sub">{{ block.settings.text | escape }}</span>{% endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Benefits row",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "paw", "options": [ { "value": "paw", "label": "Paw" }, { "value": "bolt", "label": "Bolt" }, { "value": "heart", "label": "Heart" }, { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }, { "value": "lock", "label": "Lock" }, { "value": "brain", "label": "Brain" }, { "value": "home", "label": "Home" }, { "value": "cat", "label": "Cat" }, { "value": "check", "label": "Check" } ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Keeps cats active" },
        { "type": "text", "id": "text", "label": "Text", "default": "Encourages healthy movement and exercise." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "Benefits row", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
