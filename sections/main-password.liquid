<section class="password sunburst">
  <div class="page-width page--narrow text-center password__inner">
    {% render 'wordmark', size: 56 %}
    <h1 class="h2">{{ 'general.password_page.login_form_heading' | t }}</h1>
    {%- if shop.password_message != blank %}<p>{{ shop.password_message }}</p>{% endif -%}
    {%- form 'storefront_password', class: 'password-form' -%}
      {%- if form.errors %}<p class="form__message form__message--error">{{ 'general.password_page.login_form_error' | t }}</p>{% endif -%}
      <label class="field"><span>{{ 'general.password_page.login_form_password_label' | t }}</span><input type="password" name="password" autocomplete="current-password"></label>
      <button type="submit" class="button button--cta">{{ 'general.password_page.login_password_button' | t }}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
