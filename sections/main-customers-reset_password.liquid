<section class="section page-width page--narrow customer">
  <h1 class="h1 section-title">{{ 'customer.reset_password.title' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <label class="field"><span>{{ 'customer.reset_password.password' | t }}</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
    <label class="field"><span>{{ 'customer.reset_password.password_confirm' | t }}</span><input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
    <button type="submit" class="button button--cta">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</section>
{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
